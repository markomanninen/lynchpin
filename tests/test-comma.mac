section("comma (the angle ratio and the Pythagorean comma)")$
comma : 3^12/2^19$
ratio : acos(-1/3)/(3*%pi/5)$
check("comma: (3/2)^12 / 2^7 = 531441/524288",
      is((3/2)^12/2^7 = comma) and is(comma = 531441/524288))$
check("comma: 23.460 cents", near_p(1200*log(comma)/log(2), 23.4600103846, 1e-9))$
check("ratio: 1.0136224", near_p(ratio, 1.013622413282, 1e-11))$
check("ratio: 23.424 cents", near_p(1200*log(ratio)/log(2), 23.4243970887, 1e-9))$
check("the two differ by 2.06e-5 in relative terms",
      near_p((comma - ratio)/ratio, 2.0571258e-5, 1e-11))$
check("both intervals are more than four times 5 cents",
      is(1200*float(log(ratio)/log(2)) > 20) and is(1200*float(log(comma)/log(2)) > 20))$

/* Irrationality of theta/pi for cos theta = -1/3.  With alpha = exp(i theta),
   the numbers a_n = 3^n cos(n theta) are the real parts of (3 alpha)^n. */
alpha3 : -1 + 2*sqrt(2)*%i$
check("3 alpha has modulus 3 and real part -1",
      zero_p(expand(alpha3*conjugate(alpha3)) - 9) and zero_p(realpart(alpha3) + 1))$
a_exact(n) := realpart(expand(alpha3^n))$
a_rec[0] : 1$
a_rec[1] : -1$
a_rec[n] := -2*a_rec[n-1] - 9*a_rec[n-2]$
check("a_0 = 1 and a_1 = -1", is(a_exact(0) = 1) and is(a_exact(1) = -1))$
check("recurrence a_(n+1) = -2 a_n - 9 a_(n-1) gives 3^n cos(n theta) up to n = 40",
      every(lambda([n], is(a_rec[n] = a_exact(n))), makelist(n, n, 0, 40)))$
check("every a_n is an integer up to n = 40",
      every(lambda([n], integerp(a_rec[n])), makelist(n, n, 0, 40)))$
check("every a_n with n >= 1 leaves the remainder 2 in the division by 3",
      every(lambda([n], is(mod(a_rec[n], 3) = 2)), makelist(n, n, 1, 40)))$
check("so a_n is never plus or minus 3^n, and cos(n theta) is never plus or minus 1",
      every(lambda([n], is(abs(a_rec[n]) # 3^n)), makelist(n, n, 1, 40)))$
check("a_n agrees with the numerical 3^n cos(n theta)",
      every(lambda([n], near_p(a_rec[n]/3^n, cos(n*acos(-1/3)), 1e-9)), makelist(n, n, 0, 20)))$
check("both numbers exceed 1 by about 1.36 percent",
      near_p(100*(ratio - 1), 1.36, 1e-2) and near_p(100*(comma - 1), 1.36, 1e-2))$
