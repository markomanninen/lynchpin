section("gaps (the mismatch in millimetres for a 5 cm side)")$
/* Independent construction with explicit vectors in three dimensions. */
unitv(v) := v/sqrt(v . v)$
half : 3*%pi/10$
/* Corner of the pentagon in the wedge of rays u and v that lies next to u. */
corner(u, v) := cos(half)*unitv(u + v) + sin(half)*unitv(u - v)$
len(v) := sqrt(float(v . v))$
delta : acos(-1/3) - 3*%pi/5$
A12 : corner(T[1], T[2])$
A13 : corner(T[1], T[3])$
check("the pentagon side leaves its ray by half the mismatch, 0.7356 degrees",
      near_p(acos(float(A12 . T[1]))*180/%pi, float(delta*90/%pi), 1e-9))$
check("corner to ray tip: 2 sin(delta/4), 0.64 mm",
      near_p(len(A12 - T[1]), 2*sin(delta/4), 1e-12)
      and near_p(50*len(A12 - T[1]), 0.6419366934, 1e-9))$
check("two neighbouring corners: sqrt(3) sin(delta/2), 1.11 mm",
      near_p(len(A12 - A13), sqrt(3)*sin(delta/2), 1e-12)
      and near_p(50*len(A12 - A13), 1.1118440590, 1e-9))$
check("one side laid on its ray, the other misses by 2 sin(delta/2), 1.28 mm",
      near_p(50*2*sin(delta/2), 1.2838469335, 1e-9))$
